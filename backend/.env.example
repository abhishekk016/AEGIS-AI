# Copy this file to .env and fill in values. Never commit the real .env file.

# Server
PORT=5000
NODE_ENV=development

# MongoDB (application data: users, doc metadata, chat history)
# Local: mongodb://127.0.0.1:27017/aegis_ai
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/aegis_ai
MONGO_URI=mongodb://127.0.0.1:27017/aegis_ai

# Ollama (local LLM runtime)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB (local vector store) - talked to directly over its REST API
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=aegis_docs
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# PDF extraction microservice (Python/FastAPI, wraps PyMuPDF)
# Must be running: cd python-services && uvicorn app.main:app --port 8001
PDF_SERVICE_URL=http://127.0.0.1:8001

# Upload limits
MAX_FILE_SIZE_MB=50
